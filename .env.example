# Mark43 Public Safety Intelligence Agent — Environment Variables
# Copy to .env and fill in your keys

# ─────────────────────────────────────────────────────────────
# OpenRouter — primary LLM provider (chat / reasoning)
# Get a free key at https://openrouter.ai/
# Model options: openai/gpt-4o-mini, openai/gpt-4.1-mini, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TEMPERATURE=0.2

# ─────────────────────────────────────────────────────────────
# OpenAI — used ONLY for text-embedding-3-small (embeddings)
# OpenRouter does not support embedding endpoints.
# Get a key at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────
# Chroma Cloud — vector store (dense OpenAI + sparse Splade hybrid search)
# Get your key at https://www.trychroma.com/
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_HOST=api.trychroma.com
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=mark43-rag

# ─────────────────────────────────────────────────────────────
# FBI Crime Data Explorer API (optional — enables fetch_us_crime_statistics tool)
# Free key at https://api.data.gov/signup
FBI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Agent behaviour
SESSION_SUMMARIZE_THRESHOLD=10
AGENT_MAX_ITERATIONS=5

# ─────────────────────────────────────────────────────────────
# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite proxy)
VITE_API_URL=http://localhost:4000

# Police UKThe API provides a rich data source for information, including: Neighbourhood team members, Upcoming events, Street-level crime and outcome data, Nearest police stations

POLICE_UK_API_URL=https://data.police.uk/ap